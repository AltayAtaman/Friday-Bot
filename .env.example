# Required for Telegram bridge & tray daemon
TELEGRAM_BOT_TOKEN=123456789:your-telegram-bot-token
# Required: numeric Telegram user/chat ID (bridge fails closed if unset)
TELEGRAM_CHAT_ID=123456789

# Optional personalization (HUD & prompts)
OWNER_NAME=User
TELEGRAM_USERNAME=your_telegram_handle
TELEGRAM_BOT_USERNAME=@your_friday_bot

# Optional workstation paths
FRIDAY_REPOS_ROOT=
AGY_EXE=
PYTHON_EXE=

# Optional: Gemini API key for fast voice transcription
GEMINI_API_KEY=

# Optional: Read-only Gmail IMAP scout (scripts/mail_scout.py)
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
